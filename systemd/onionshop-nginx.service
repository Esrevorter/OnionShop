# nginx instance serving the loopback TLS endpoint for the onion.
# Requires the vendored hardened nginx build path; adjust ExecStart if your
# distro's nginx lives elsewhere. Runs AFTER the app so the socket exists.
[Unit]
Description=OnionShop nginx reverse proxy (loopback TLS gatekeeper)
After=network.target onionshop-app.service
BindsTo=onionshop-app.service
PartOf=onionshop-app.service

[Service]
Type=notify
User=nginx
Group=nginxsock
ExecStartPre=/usr/sbin/nginx -t -c /etc/onionshop/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/onionshop/nginx.conf -g 'daemon off;'
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_KILL CAP_SETUID CAP_SETGID
AmbientCapabilities=
ReadWritePaths=/var/run/onionshop
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
LimitNOFILE=65536
TasksMax=128

[Install]
WantedBy=multi-user.target
