# OnionShop Tor hidden-service configuration template.
# Review against the actual host port bindings and torrc syntax before use.
# TLS authenticity is NOT provided by this file or by the development cert script.

Sandbox 1
KeepalivePeriod 60
NewCircuitPeriod 30
MaxCircuitDirtiness 600

# Hidden service: v3 only. Keep keys on encrypted storage with tor ownership.
HiddenServiceDir /var/lib/tor/onionshop
HiddenServiceVersion 3
# Onion port 80 -> nginx cleartext listener, which must redirect to HTTPS.
HiddenServicePort 80 127.0.0.1:8080
# Onion port 443 -> nginx TLS listener.
HiddenServicePort 443 127.0.0.1:8443

# Tor PoW options require a compatible Tor release; verify support before enabling.
HiddenServicePoWDefensesEnabled 1
HiddenServicePoWQueueRate 25
HiddenServicePoWQueueBurst 50

ORPort 0
ExitRelay 0
SocksPort 0
ControlPort 0
AvoidDiskWrites 1
